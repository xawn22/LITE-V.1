#!/bin/bash
LOCK_FILE="/etc/user_locks.db"
XRAY_CONFIG="/etc/xray/config.json"
BACKUP_DIR="/etc/xray/backups"
mkdir -p "$BACKUP_DIR"
mkdir -p /etc/vmess/
mkdir -p /etc/limit/vmess/ip/

# ============================================
# FUNGSI SEND NOTIF QUOTA
# ============================================
function send-log-quota() {
    CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
    KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
    TIME="10"
    URL="https://api.telegram.org/bot$KEY/sendMessage"
    TEXT="
══════════════════════════
   ⚠️  QUOTA NOTIFICATION  
══════════════════════════
🔒 Protocol : <b>vmess</b>       
👤 User     : <code>${user}</code>    
📊 Limit    : <code>${limitku}</code>    
📈 Usage    : <code>${total}</code>    
⚡ Status   : <code>🔴 User Dibanned</code>
══════════════════════════
💬 <i>Batas terlampaui.!!!</i>
══════════════════════════
⚡ SMART NOTIF SERVER ⚡   
══════════════════════════
"
    curl -s --max-time $TIME -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" $URL >/dev/null
}

# ============================================
# FUNGSI CONVERT SIZE
# ============================================
function con() {
    local -i bytes=$1
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes} B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$(printf "%.1f" "$(echo "scale=1; $bytes/1024" | bc)") KB"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$(printf "%.1f" "$(echo "scale=1; $bytes/1048576" | bc)") MB"
    else
        echo "$(printf "%.1f" "$(echo "scale=1; $bytes/1073741824" | bc)") GB"
    fi
}

# ============================================
# FUNGSI MODIFY XRAY CONFIG (LOCK/UNLOCK)
# ============================================
function modify_xray_config() {
    local action="$1"
    local user="$2"
    local protocol="vmess"
    local marker="### $user"

    if [[ $action == "lock" ]]; then
        # Backup per user (dengan timestamp)
        local backup_file="$BACKUP_DIR/config.json.$user.$(date +%Y%m%d-%H%M%S).bak"
        cp "$XRAY_CONFIG" "$backup_file"
        echo -e "✅ Backup created: $(basename $backup_file)"
        
        # Remove user entry from configuration
        sed -i "/^${marker}/,/^},{/d" "$XRAY_CONFIG"
        
        # Remove user from the vmess database
        sed -i "/^### $user /d" /etc/vmess/.vmess.db
        echo -e "🔒 User '$user' on protocol '$protocol' has been locked."

    elif [[ $action == "unlock" ]]; then
        # Cari backup khusus untuk user ini (paling baru)
        local user_backup=$(ls -t "$BACKUP_DIR"/config.json."$user".*.bak 2>/dev/null | head -1)
        
        if [[ -f "$user_backup" ]]; then
            cp "$user_backup" "$XRAY_CONFIG"
            echo -e "✅ Restored from: $(basename $user_backup)"
            
            # Hapus backup setelah restore (biar ga numpuk)
            rm -f "$user_backup"
            echo -e "🧹 Backup file deleted"
            
        else
            echo -e "❌ Backup not found for user '$user'!"
            echo -e "   Mencari backup terakhir..."
            
            # Fallback ke backup terakhir (jika ada)
            local latest_backup=$(ls -t "$BACKUP_DIR"/config.json.*.bak 2>/dev/null | head -1)
            if [[ -f "$latest_backup" ]]; then
                echo -e "⚠️  Using fallback: $(basename $latest_backup)"
                cp "$latest_backup" "$XRAY_CONFIG"
            else
                echo -e "❌ No backup found at all!"
                return 1
            fi
        fi
    fi
}

# ============================================
# FUNGSI LOCK USER
# ============================================
function lock_user() {
    local user="$1"
    if [[ -z "$user" ]]; then
        echo -e "❌ Username cannot be empty!"
        return
    fi

    # Check if already locked
    if grep -qw "vmess:${user}" "$LOCK_FILE"; then
        echo -e "⚠️ User '$user' on vmess is already locked!"
        return
    fi

    # Add to lock file
    echo "vmess:${user}" >> "$LOCK_FILE"
    
    # Lock user
    if modify_xray_config "lock" "$user"; then
        reload_services
        echo -e "✅ User '$user' successfully locked."
    else
        echo -e "❌ Failed to lock user '$user'."
        # Rollback: hapus dari lock file
        sed -i "/^vmess:${user}$/d" "$LOCK_FILE"
    fi
}

# ============================================
# FUNGSI UNLOCK USER
# ============================================
function unlock_user() {
    local user="$1"
    if [[ -z "$user" ]]; then
        echo -e "❌ Username cannot be empty!"
        return
    fi

    # Check if the user is locked
    if ! grep -qw "vmess:${user}" "$LOCK_FILE"; then
        echo -e "⚠️ User '$user' on vmess is not locked."
        return
    fi

    # Unlock user
    if modify_xray_config "unlock" "$user"; then
        # Remove from lock file
        sed -i "/^vmess:${user}$/d" "$LOCK_FILE"
        reload_services
        echo -e "✅ User '$user' successfully unlocked."
    else
        echo -e "❌ Failed to unlock user '$user'."
    fi
}

# ============================================
# FUNGSI RELOAD SERVICES
# ============================================
function reload_services() {
    systemctl restart xray > /dev/null 2>&1
    echo -e "🔄 Xray service restarted."
}

# ============================================
# FUNGSI AUTO-LOCK BERDASARKAN QUOTA
# ============================================
function memulai_pengecekan() {
    sleep 30
    data=($(grep '^###' /etc/xray/config.json | cut -d ' ' -f 2 | sort | uniq))
    [[ ! -e /etc/limit/vmess ]] && mkdir -p /etc/limit/vmess

    # Collect usage data
    for user in "${data[@]}"; do
        xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" >& /tmp/${user}
        getThis=$(awk '{print $1}' /tmp/${user})
        if [[ ${getThis} != "failed" ]]; then
            downlink=$(xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" | grep -w "value" | awk '{print $2}' | cut -d '"' -f2)
            if [[ -e /etc/limit/vmess/${user} ]]; then
                plus2=$(cat /etc/limit/vmess/${user})
                if [[ ${#plus2} -gt 0 ]]; then
                    plus3=$(( downlink + plus2 ))
                    echo "${plus3}" > /etc/limit/vmess/"${user}"
                else
                    echo "${downlink}" > /etc/limit/vmess/"${user}"
                fi
                xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" -reset > /dev/null 2>&1
            else
                echo "${downlink}" > /etc/limit/vmess/"${user}"
                xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" -reset > /dev/null 2>&1
            fi
        fi
    done

    # Check quota and lock if exceeded
    for user in "${data[@]}"; do
        if [[ -e /etc/vmess/${user} ]]; then
            checkLimit=$(cat /etc/vmess/${user})
            if [[ ${#checkLimit} -gt 1 ]]; then
                if [[ -e /etc/limit/vmess/${user} ]]; then
                    Usage=$(cat /etc/limit/vmess/${user})
                    if [[ ${Usage} -gt ${checkLimit} ]]; then
                        total=$(con ${Usage})
                        limitku=$(con ${checkLimit})
                        send-log-quota
                        lock_user "$user"
                        continue
                    fi
                fi
            fi
        fi
    done 
}

memulai_pengecekan